__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# R
renv/
.Rhistory
.RData

# Paper build artifacts
paper/output.pdf
paper/*.aux
paper/*.log

# Editors
.vscode/
.idea/
